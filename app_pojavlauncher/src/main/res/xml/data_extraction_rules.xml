<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="accounts/" />
        <exclude domain="no_backup" path="aether_vault/" />
        <exclude domain="database" path="aether_launcher.db" />
        <exclude domain="database" path="aether_launcher.db-shm" />
        <exclude domain="database" path="aether_launcher.db-wal" />
        <exclude domain="sharedpref" path="aether_vault_fallback.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="accounts/" />
        <exclude domain="no_backup" path="aether_vault/" />
        <exclude domain="database" path="aether_launcher.db" />
        <exclude domain="database" path="aether_launcher.db-shm" />
        <exclude domain="database" path="aether_launcher.db-wal" />
        <exclude domain="sharedpref" path="aether_vault_fallback.xml" />
    </device-transfer>
</data-extraction-rules>
