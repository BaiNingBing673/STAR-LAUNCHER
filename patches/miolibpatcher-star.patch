diff --git a/src/main/java/com/mio/libpatcher/transformer/FrontendFrameProbeTransformer.java b/src/main/java/com/mio/libpatcher/transformer/FrontendFrameProbeTransformer.java
new file mode 100644
index 0000000..f7591ac
--- /dev/null
+++ b/src/main/java/com/mio/libpatcher/transformer/FrontendFrameProbeTransformer.java
@@ -0,0 +1,140 @@
+package com.mio.libpatcher.transformer;
+
+import com.mio.libpatcher.util.LogUtil;
+import javassist.CtClass;
+import javassist.CtField;
+import javassist.CtMethod;
+import javassist.CtNewMethod;
+import javassist.NotFoundException;
+
+/**
+ * Passive RenderPearl FrontendGpuSurface frame-time probe for M8 apples-to-apples
+ * comparison across backends (e.g. OpenGL ES vs STAR GFX Vulkan) with near-zero overhead.
+ */
+public class FrontendFrameProbeTransformer implements BaseTransformer {
+
+    @Override
+    public String getTargetClassName() {
+        return "com.mojang.renderpearl.frontend.FrontendGpuSurface";
+    }
+
+    @Override
+    public void transform(CtClass clazz) throws Throwable {
+        if (clazz.isFrozen()) {
+            clazz.defrost();
+        }
+
+        CtMethod acquireMethod;
+        CtMethod blitMethod;
+        CtMethod presentMethod;
+        try {
+            acquireMethod = clazz.getDeclaredMethod("acquireNextTexture");
+            blitMethod = clazz.getDeclaredMethod("blitFromTexture");
+            presentMethod = clazz.getDeclaredMethod("present");
+        } catch (NotFoundException ignored) {
+            return;
+        }
+
+        clazz.addField(CtField.make("private static final int rpBenchWin = 120;", clazz));
+        clazz.addField(CtField.make("private static final double[] rpBenchMs = new double[120];", clazz));
+        clazz.addField(CtField.make("private static int rpBenchCount = 0;", clazz));
+        clazz.addField(CtField.make("private static long rpBenchLastEndNs = 0L;", clazz));
+        clazz.addField(CtField.make("private static long rpBenchSumAcqNs = 0L;", clazz));
+        clazz.addField(CtField.make("private static long rpBenchSumBlitNs = 0L;", clazz));
+        clazz.addField(CtField.make("private static long rpBenchSumPresNs = 0L;", clazz));
+        clazz.addField(CtField.make("private static long rpBenchLastAcqNs = 0L;", clazz));
+        clazz.addField(CtField.make("private static long rpBenchLastBlitNs = 0L;", clazz));
+
+        clazz.addMethod(CtNewMethod.make(
+                "private static long rpReadVmRssKb() {" +
+                        "  java.io.BufferedReader br = null;" +
+                        "  try {" +
+                        "    br = new java.io.BufferedReader(new java.io.FileReader(\"/proc/self/status\"));" +
+                        "    String line;" +
+                        "    while ((line = br.readLine()) != null) {" +
+                        "      if (line.startsWith(\"VmRSS:\")) {" +
+                        "        String rest = line.substring(6).trim();" +
+                        "        int sp = rest.indexOf(' ');" +
+                        "        String num = sp > 0 ? rest.substring(0, sp) : rest;" +
+                        "        return java.lang.Long.parseLong(num);" +
+                        "      }" +
+                        "    }" +
+                        "  } catch (Throwable ignored) {" +
+                        "  } finally {" +
+                        "    if (br != null) { try { br.close(); } catch (Throwable ignored2) {} }" +
+                        "  }" +
+                        "  return -1L;" +
+                        "}",
+                clazz
+        ));
+
+        clazz.addMethod(CtNewMethod.make(
+                "private static void rpRecordPresent(Object backendObj, long acqNs, long blitNs, long presNs, long endNs) {" +
+                        "  long prev = rpBenchLastEndNs;" +
+                        "  rpBenchLastEndNs = endNs;" +
+                        "  if (prev == 0L) return;" +
+                        "  double dtMs = (double)(endNs - prev) / 1000000.0;" +
+                        "  if (dtMs <= 0.0 || dtMs > 5000.0) return;" +
+                        "  rpBenchMs[rpBenchCount] = dtMs;" +
+                        "  rpBenchSumAcqNs += acqNs;" +
+                        "  rpBenchSumBlitNs += blitNs;" +
+                        "  rpBenchSumPresNs += presNs;" +
+                        "  rpBenchCount++;" +
+                        "  if (rpBenchCount < rpBenchWin) return;" +
+                        "  double[] sorted = new double[rpBenchWin];" +
+                        "  double sum = 0.0;" +
+                        "  for (int i = 0; i < rpBenchWin; i++) {" +
+                        "    sorted[i] = rpBenchMs[i];" +
+                        "    sum += sorted[i];" +
+                        "  }" +
+                        "  java.util.Arrays.sort(sorted);" +
+                        "  double avgMs = sum / (double) rpBenchWin;" +
+                        "  double var = 0.0;" +
+                        "  for (int i = 0; i < rpBenchWin; i++) {" +
+                        "    double d = rpBenchMs[i] - avgMs;" +
+                        "    var += d * d;" +
+                        "  }" +
+                        "  double stddevMs = java.lang.Math.sqrt(var / (double) rpBenchWin);" +
+                        "  double p50Ms = sorted[rpBenchWin / 2];" +
+                        "  double p95Ms = sorted[(rpBenchWin * 95) / 100];" +
+                        "  double p99Ms = sorted[rpBenchWin - 1];" +
+                        "  int n1 = java.lang.Math.max(1, rpBenchWin / 100);" +
+                        "  double slowSum = 0.0;" +
+                        "  for (int i = rpBenchWin - n1; i < rpBenchWin; i++) { slowSum += sorted[i]; }" +
+                        "  double slow1Ms = slowSum / (double) n1;" +
+                        "  double avgFps = avgMs > 0.0 ? (1000.0 / avgMs) : 0.0;" +
+                        "  double low1Fps = slow1Ms > 0.0 ? (1000.0 / slow1Ms) : 0.0;" +
+                        "  double acqMs = (double) rpBenchSumAcqNs / (1000000.0 * (double) rpBenchWin);" +
+                        "  double blitMs = (double) rpBenchSumBlitNs / (1000000.0 * (double) rpBenchWin);" +
+                        "  double presMs = (double) rpBenchSumPresNs / (1000000.0 * (double) rpBenchWin);" +
+                        "  long rssMb = rpReadVmRssKb() / 1024L;" +
+                        "  Runtime rt = Runtime.getRuntime();" +
+                        "  long heapMb = (rt.totalMemory() - rt.freeMemory()) / (1024L * 1024L);" +
+                        "  String bName = backendObj != null ? backendObj.getClass().getSimpleName() : \"unknown\";" +
+                        "  String renderer = System.getProperty(\"renderer\", System.getenv(\"RENDERER\") != null ? System.getenv(\"RENDERER\") : \"unknown\");" +
+                        "  System.out.println(String.format(java.util.Locale.US, " +
+                        "    \"[RENDERPEARL_BENCH] backend=%s env=%s frames=%d avgFps=%.2f low1Fps=%.2f avgMs=%.3f stddevMs=%.3f p50Ms=%.3f p95Ms=%.3f p99Ms=%.3f acqMs=%.3f blitMs=%.3f presMs=%.3f rssMB=%d heapMB=%d\", " +
+                        "    new Object[] { bName, renderer, Integer.valueOf(rpBenchWin), Double.valueOf(avgFps), Double.valueOf(low1Fps), Double.valueOf(avgMs), Double.valueOf(stddevMs), Double.valueOf(p50Ms), Double.valueOf(p95Ms), Double.valueOf(p99Ms), Double.valueOf(acqMs), Double.valueOf(blitMs), Double.valueOf(presMs), Long.valueOf(rssMb), Long.valueOf(heapMb) }));" +
+                        "  rpBenchCount = 0;" +
+                        "  rpBenchSumAcqNs = 0L;" +
+                        "  rpBenchSumBlitNs = 0L;" +
+                        "  rpBenchSumPresNs = 0L;" +
+                        "}",
+                clazz
+        ));
+
+        acquireMethod.addLocalVariable("_rpAcqT0", CtClass.longType);
+        acquireMethod.insertBefore("{ _rpAcqT0 = System.nanoTime(); }");
+        acquireMethod.insertAfter("{ rpBenchLastAcqNs = System.nanoTime() - _rpAcqT0; }");
+
+        blitMethod.addLocalVariable("_rpBlitT0", CtClass.longType);
+        blitMethod.insertBefore("{ _rpBlitT0 = System.nanoTime(); }");
+        blitMethod.insertAfter("{ rpBenchLastBlitNs = System.nanoTime() - _rpBlitT0; }");
+
+        presentMethod.addLocalVariable("_rpPresT0", CtClass.longType);
+        presentMethod.insertBefore("{ _rpPresT0 = System.nanoTime(); }");
+        presentMethod.insertAfter("{ long _rpEnd = System.nanoTime(); rpRecordPresent(this.backend, rpBenchLastAcqNs, rpBenchLastBlitNs, _rpEnd - _rpPresT0, _rpEnd); }");
+
+        LogUtil.info("Patched FrontendGpuSurface with passive [RENDERPEARL_BENCH] probe");
+    }
+}
diff --git a/src/main/java/com/mio/libpatcher/transformer/GLTransformer.java b/src/main/java/com/mio/libpatcher/transformer/GLTransformer.java
new file mode 100644
