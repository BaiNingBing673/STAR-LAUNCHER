+    @Test
+    void minecraftSurfaceResumeRecovery() throws Throwable {
+        ClassPool pool = new ClassPool(true);
+        CtClass sdlHints = pool.makeClass("org.lwjgl.sdl.SDLHints");
+        sdlHints.addField(CtField.make("public static boolean surfaceReady = true;", sdlHints));
+        sdlHints.addMethod(CtMethod.make("public static boolean SDL_GetHintBoolean(CharSequence name, boolean def) { return surfaceReady; }", sdlHints));
+
+        CtClass mc = pool.makeClass("net.minecraft.client.Minecraft");
+        mc.addField(CtField.make("private boolean surfaceIsInvalid;", mc));
+        mc.addField(CtField.make("private boolean windowSurfaceNeedsReconfiguring;", mc));
+        mc.addMethod(CtMethod.make("public void renderFrame(boolean renderLevel) {}", mc));
+
+        new MinecraftSurfaceResumeTransformer().transform(mc);
+        mc.toBytecode();
+
+        ClassLoader cl = new ClassLoader(BaseTransformerSmokeTest.class.getClassLoader()) {};
+        Class<?> hintsClass = sdlHints.toClass(cl, null);
+        Class<?> mcClass = mc.toClass(cl, null);
+        Object instance = mcClass.getDeclaredConstructor().newInstance();
+
+        java.lang.reflect.Field invalidField = mcClass.getDeclaredField("surfaceIsInvalid");
+        java.lang.reflect.Field reconfigField = mcClass.getDeclaredField("windowSurfaceNeedsReconfiguring");
+        invalidField.setAccessible(true);
+        reconfigField.setAccessible(true);
+        java.lang.reflect.Method renderFrame = mcClass.getMethod("renderFrame", boolean.class);
+
+        // Background: surfaceReady=false marks surfaceIsInvalid=true without spamming reconfig
+        hintsClass.getField("surfaceReady").setBoolean(null, false);
+        reconfigField.setBoolean(instance, true);
+        renderFrame.invoke(instance, true);
+        assertEquals(true, invalidField.getBoolean(instance));
+        assertEquals(false, reconfigField.getBoolean(instance));
+
+        // Foreground resume: surfaceReady=true triggers windowSurfaceNeedsReconfiguring=true
+        hintsClass.getField("surfaceReady").setBoolean(null, true);
+        renderFrame.invoke(instance, true);
+        assertEquals(true, reconfigField.getBoolean(instance));
+    }
