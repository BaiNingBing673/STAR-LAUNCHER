@@ -0,0 +1,54 @@
+package com.mio.libpatcher.transformer;
+
+import com.mio.libpatcher.util.LogUtil;
+import javassist.CannotCompileException;
+import javassist.CtClass;
+import javassist.CtMethod;
+import javassist.expr.ExprEditor;
+import javassist.expr.MethodCall;
+
+/**
+ * Renames RenderPearl's OpenGL decompiled UBO instance variables away from names
+ * containing the substring "uniform" ({@code _uniform_instance_*} -> {@code _rp_inst_*}).
+ *
+ * <p>MobileGlues's GLSL post-processor scans for {@code uniform} without word
+ * boundaries; expressions like {@code if (_uniform_instance_00_00.UseRgss == 1)}
+ * in Minecraft 26.3's {@code core/terrain.fsh} get rewritten into broken syntax
+ * ({@code if (_uniform _instance_00_00 ;}) and fail shader compilation.
+ * The UBO block and sampler names ({@code _uniform_%02d_%02d}) stay unchanged so
+ * {@code GlProgram.setupBindGroupLayouts} resolves bindings identically.
+ */
+public class GlShaderUniformNameTransformer implements BaseTransformer {
+
+    @Override
+    public String getTargetClassName() {
+        return "com.mojang.renderpearl.backend.opengl.GlPipelineRecompiler";
+    }
+
+    @Override
+    public void transform(CtClass clazz) throws Throwable {
+        if (clazz.isFrozen()) {
+            clazz.defrost();
+        }
+        CtMethod renameDescriptors = clazz.getDeclaredMethod("renameDescriptors");
+        renameDescriptors.instrument(new ExprEditor() {
+            @Override
+            public void edit(MethodCall m) throws CannotCompileException {
+                if ("java.lang.String".equals(m.getClassName())
+                        && "format".equals(m.getMethodName())
+                        && "(Ljava/util/Locale;Ljava/lang/String;[Ljava/lang/Object;)Ljava/lang/String;".equals(m.getSignature())) {
+                    m.replace(
+                            "{ " +
+                                    "  if (\"_uniform_instance_%02d_%02d\".equals($2)) {" +
+                                    "    $_ = java.lang.String.format($1, \"_rp_inst_%02d_%02d\", $3);" +
+                                    "  } else {" +
+                                    "    $_ = $proceed($$);" +
+                                    "  }" +
+                                    "}"
+                    );
+                }
+            }
+        });
+        LogUtil.info("Patched GlPipelineRecompiler UBO instance names for MobileGlues compatibility");
+    }
+}
diff --git a/src/main/java/com/mio/libpatcher/transformer/GlSingleWindowTransformer.java b/src/main/java/com/mio/libpatcher/transformer/GlSingleWindowTransformer.java
new file mode 100644
index 0000000..dd19325
--- /dev/null
+++ b/src/main/java/com/mio/libpatcher/transformer/GlSingleWindowTransformer.java
@@ -0,0 +1,156 @@
+package com.mio.libpatcher.transformer;
+
+import com.mio.libpatcher.util.LogUtil;
+import javassist.CannotCompileException;
+import javassist.CtClass;
+import javassist.CtConstructor;
+import javassist.CtMethod;
+import javassist.NotFoundException;
+import javassist.expr.ExprEditor;
+import javassist.expr.MethodCall;
+
+import java.util.Arrays;
+import java.util.List;
+
+/**
+ * Allows RenderPearl's OpenGL backend to initialize and run on Android SDL3, where
+ * SDL enforces a single-window limit ("Android only supports one window").
+ * Skips the hidden test window probe in GlDevice and reuses the initial utility
+ * SDL window handle when Window creates the main game window.
+ *
+ * State is shared via JVM system properties instead of adding methods to GlBackend
+ * so GlDevice transforms independently even when Javassist loads an untransformed
+ * GlBackend bytecode stub from disk.
+ */
+public class GlSingleWindowTransformer implements BaseTransformer {
+
+    private static final String GL_BACKEND = "com.mojang.renderpearl.backend.opengl.GlBackend";
+    private static final String GL_DEVICE = "com.mojang.renderpearl.backend.opengl.GlDevice";
+    private static final String UTILITY_TITLE = "Minecraft - RenderPearl OpenGL Hidden Utility Window";
+    private static final String TEST_TITLE = "Minecraft - RenderPearl OpenGL Hidden Test Window";
+    private static final String PROP_WINDOW = "mio.rp.gl.singleWindow";
+    private static final String PROP_CLAIMED = "mio.rp.gl.windowClaimed";
+    // SDL_WINDOW_OPENGL (0x2) | SDL_WINDOW_RESIZABLE (0x20) | SDL_WINDOW_HIGH_PIXEL_DENSITY (0x2000)
+    private static final long ANDROID_WINDOW_FLAGS = 8226L;
+
+    @Override
+    public List<String> getTargetClassNames() {
+        return Arrays.asList(GL_BACKEND, GL_DEVICE);
+    }
+
+    @Override
+    public void transform(CtClass clazz) throws Throwable {
+        if (clazz.isFrozen()) {
+            clazz.defrost();
+        }
+        String name = clazz.getName();
+        if (GL_BACKEND.equals(name)) {
+            patchGlBackend(clazz);
+        } else if (GL_DEVICE.equals(name)) {
+            patchGlDevice(clazz);
+        }
+    }
+
+    private static void patchGlBackend(CtClass clazz) throws NotFoundException, CannotCompileException {
+        CtMethod createWindow = clazz.getDeclaredMethod("createWindow");
+        // Use insertBefore + insertAfter on GlBackend.createWindow itself rather than
+        // matching SDLVideo.SDL_CreateWindow via ExprEditor, because mods like Sodium
+        // @Redirect SDLVideo.SDL_CreateWindow at Mixin time before the Java agent runs.
+        createWindow.insertAfter(
+                "{ " +
+                        "  if (\"Android\".equals(org.lwjgl.sdl.SDLPlatform.SDL_GetPlatform()) && $_ != 0L) {" +
+                        "    if (java.lang.System.getProperty(\"" + PROP_WINDOW + "\") == null) {" +
+                        "      java.lang.System.setProperty(\"" + PROP_WINDOW + "\", java.lang.Long.toString($_));" +
+                        "      String mioTitle = $1 != null ? $1.toString() : \"\";" +
+                        "      java.lang.System.setProperty(\"" + PROP_CLAIMED + "\", \"" + UTILITY_TITLE + "\".equals(mioTitle) ? \"false\" : \"true\");" +
+                        "    }" +
+                        "  }" +
+                        "}"
+        );
+        createWindow.insertBefore(
+                "{ " +
+                        "  if (\"Android\".equals(org.lwjgl.sdl.SDLPlatform.SDL_GetPlatform())) {" +
+                        "    String mioTitle = $1 != null ? $1.toString() : \"\";" +
+                        "    String mioSaved = java.lang.System.getProperty(\"" + PROP_WINDOW + "\");" +
+                        "    if (mioSaved != null) {" +
+                        "      long mioHandle = java.lang.Long.parseLong(mioSaved);" +
+                        "      if (!\"" + UTILITY_TITLE + "\".equals(mioTitle)) {" +
+                        "        java.lang.System.setProperty(\"" + PROP_CLAIMED + "\", \"true\");" +
+                        "        org.lwjgl.sdl.SDLVideo.SDL_SetWindowTitle(mioHandle, $1);" +
+                        "        org.lwjgl.sdl.SDLVideo.SDL_SetWindowSize(mioHandle, $2, $3);" +
+                        "      }" +
+                        "      return mioHandle;" +
+                        "    }" +
+                        "    if (\"" + UTILITY_TITLE + "\".equals(mioTitle)) {" +
+                        "      $4 = " + ANDROID_WINDOW_FLAGS + "L;" +
+                        "    }" +
+                        "  }" +
+                        "}"
+        );
+        LogUtil.info("Patched GlBackend for Android single-window reuse");
+    }
+
+    private static void patchGlDevice(CtClass clazz) throws NotFoundException, CannotCompileException {
+        CtConstructor ctor = clazz.getDeclaredConstructor(new CtClass[]{
+                clazz.getClassPool().get(GL_BACKEND),
+                clazz.getClassPool().get("com.mojang.renderpearl.api.device.GpuDebugOptions")
+        });
+        ctor.instrument(new ExprEditor() {
+            @Override
+            public void edit(MethodCall m) throws CannotCompileException {
+                if (GL_BACKEND.equals(m.getClassName()) && "createWindow".equals(m.getMethodName())) {
+                    m.replace(
+                            "{ " +
+                                    "  if (\"Android\".equals(org.lwjgl.sdl.SDLPlatform.SDL_GetPlatform()) && \"" + TEST_TITLE + "\".equals($1)) {" +
+                                    "    $_ = -1L;" +
+                                    "  } else {" +
+                                    "    $_ = $proceed($$);" +
+                                    "  }" +
+                                    "}"
+                    );
+                } else if ("org.lwjgl.sdl.SDLVideo".equals(m.getClassName())
+                        && "SDL_DestroyWindow".equals(m.getMethodName())) {
+                    m.replace(
+                            "{ " +
+                                    "  if ($1 != -1L) {" +
+                                    "    $proceed($$);" +
+                                    "    String mioSaved = java.lang.System.getProperty(\"" + PROP_WINDOW + "\");" +
+                                    "    if (mioSaved != null && $1 == java.lang.Long.parseLong(mioSaved)) {" +
+                                    "      java.lang.System.clearProperty(\"" + PROP_WINDOW + "\");" +
+                                    "      java.lang.System.clearProperty(\"" + PROP_CLAIMED + "\");" +
+                                    "    }" +
+                                    "  }" +
+                                    "}"
+                    );
+                }
+            }
+        });
+
+        CtMethod close = clazz.getDeclaredMethod("close");
+        close.instrument(new ExprEditor() {
+            @Override
+            public void edit(MethodCall m) throws CannotCompileException {
+                if ("org.lwjgl.sdl.SDLVideo".equals(m.getClassName())
+                        && "SDL_DestroyWindow".equals(m.getMethodName())) {
+                    m.replace(
+                            "{ " +
+                                    "  String mioSaved = java.lang.System.getProperty(\"" + PROP_WINDOW + "\");" +
+                                    "  boolean mioClaimed = \"true\".equals(java.lang.System.getProperty(\"" + PROP_CLAIMED + "\"));" +
+                                    "  if (mioClaimed && mioSaved != null && $1 == java.lang.Long.parseLong(mioSaved)) {" +
+                                    "    java.lang.System.clearProperty(\"" + PROP_WINDOW + "\");" +
+                                    "    java.lang.System.clearProperty(\"" + PROP_CLAIMED + "\");" +
+                                    "  } else {" +
+                                    "    $proceed($$);" +
+                                    "    if (mioSaved != null && $1 == java.lang.Long.parseLong(mioSaved)) {" +
+                                    "      java.lang.System.clearProperty(\"" + PROP_WINDOW + "\");" +
+                                    "      java.lang.System.clearProperty(\"" + PROP_CLAIMED + "\");" +
+                                    "    }" +
+                                    "  }" +
+                                    "}"
+                    );
+                }
+            }
+        });
+        LogUtil.info("Patched GlDevice for Android single-window lifecycle");
+    }
+}
diff --git a/src/main/java/com/mio/libpatcher/transformer/MinecraftSurfaceResumeTransformer.java b/src/main/java/com/mio/libpatcher/transformer/MinecraftSurfaceResumeTransformer.java
new file mode 100644
index 0000000..700d799
--- /dev/null
+++ b/src/main/java/com/mio/libpatcher/transformer/MinecraftSurfaceResumeTransformer.java
@@ -0,0 +1,54 @@
+package com.mio.libpatcher.transformer;
+
+import com.mio.libpatcher.util.LogUtil;
+import javassist.CtClass;
+import javassist.CtField;
+import javassist.CtMethod;
+import javassist.NotFoundException;
+
+/**
+ * Keeps RenderPearl's surfaceInvalid/windowSurfaceNeedsReconfiguring state
+ * synchronized with Android's SurfaceView lifecycle on Minecraft 26.3+.
+ * Without this, an Android background/foreground cycle that destroys the surface
+ * at the same resolution leaves surfaceIsInvalid=true while
+ * windowSurfaceNeedsReconfiguring=false, causing a permanent black screen.
+ */
+public class MinecraftSurfaceResumeTransformer implements BaseTransformer {
+
+    @Override
+    public String getTargetClassName() {
+        return "net.minecraft.client.Minecraft";
+    }
+
+    @Override
+    public void transform(CtClass clazz) throws Throwable {
+        CtMethod renderFrame;
+        try {
+            clazz.getDeclaredField("surfaceIsInvalid");
+            clazz.getDeclaredField("windowSurfaceNeedsReconfiguring");
+            renderFrame = clazz.getDeclaredMethod("renderFrame", new CtClass[]{CtClass.booleanType});
+        } catch (NotFoundException ignored) {
+            return;
