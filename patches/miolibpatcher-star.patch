+package com.mio.libpatcher.transformer;
+
+import com.mio.libpatcher.util.LogUtil;
+import javassist.CtClass;
+import javassist.CtMethod;
+import javassist.CtNewMethod;
+import javassist.NotFoundException;
+
+/**
+ * Injects com.star.renderpearl.StarGfxGpuBackend into net.minecraft.client.PreferredGraphicsApi.getBackendsToTry()
+ * when -Dstar.gfx.renderpearl.enable=true is active on RenderPearl 26.4+ clients.
+ */
+public class StarGfxBackendTransformer implements BaseTransformer {
+
+    @Override
+    public String getTargetClassName() {
+        return "net.minecraft.client.PreferredGraphicsApi";
+    }
+
+    @Override
+    public void transform(CtClass clazz) throws Throwable {
+        if (!Boolean.getBoolean("star.gfx.renderpearl.enable")) {
+            return;
+        }
+        CtMethod method;
+        try {
+            method = clazz.getDeclaredMethod("getBackendsToTry");
+        } catch (NotFoundException ignored) {
+            return;
+        }
+
+        if (clazz.isFrozen()) {
+            clazz.defrost();
+        }
+
+        clazz.addMethod(CtNewMethod.make(
+                "private static com.mojang.renderpearl.api.device.GpuBackend[] starGfxHookBackends(" +
+                        "  com.mojang.renderpearl.api.device.GpuBackend[] orig," +
+                        "  net.minecraft.client.PreferredGraphicsApi self) {" +
+                        "  if (!java.lang.Boolean.getBoolean(\"star.gfx.renderpearl.enable\")) { return orig; }" +
+                        "  if (self != null && \"OPENGL\".equals(self.name())) { return orig; }" +
+                        "  try {" +
+                        "    java.lang.ClassLoader cl = self != null ? self.getClass().getClassLoader() : null;" +
+                        "    java.lang.Class.forName(\"com.mojang.renderpearl.api.commands.RenderPassDescriptor$Attachment$ClearValue\", false, cl);" +
+                        "    java.lang.Class cls = java.lang.Class.forName(\"com.star.renderpearl.StarGfxGpuBackend\");" +
+                        "    com.mojang.renderpearl.api.device.GpuBackend star = (com.mojang.renderpearl.api.device.GpuBackend)" +
+                        "      cls.getConstructor(new java.lang.Class[0]).newInstance(new java.lang.Object[0]);" +
+                        "    if (java.lang.Boolean.getBoolean(\"star.gfx.renderpearl.strict\")) {" +
+                        "      return new com.mojang.renderpearl.api.device.GpuBackend[] { star };" +
+                        "    }" +
+                        "    if (orig == null || orig.length == 0) {" +
+                        "      return new com.mojang.renderpearl.api.device.GpuBackend[] { star };" +
+                        "    }" +
+                        "    com.mojang.renderpearl.api.device.GpuBackend[] out = new com.mojang.renderpearl.api.device.GpuBackend[orig.length + 1];" +
+                        "    out[0] = star;" +
+                        "    for (int i = 0; i < orig.length; i++) { out[i + 1] = orig[i]; }" +
+                        "    return out;" +
+                        "  } catch (Throwable t) {" +
+                        "    java.lang.System.err.println(\"[STAR_GFX_HAL] Failed to inject StarGfxGpuBackend: \" + t);" +
+                        "    t.printStackTrace();" +
+                        "    return orig;" +
+                        "  }" +
+                        "}",
+                clazz
+        ));
+
+        method.insertAfter("{ $_ = starGfxHookBackends($_, $0); }");
+        LogUtil.info("Patched PreferredGraphicsApi.getBackendsToTry for STAR GFX RenderPearl");
+    }
+}
