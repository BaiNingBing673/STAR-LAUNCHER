+            }
+        });
+    }
+
+    private static void patchPresent(CtClass clazz) throws NotFoundException, CannotCompileException {
+        CtMethod present = clazz.getDeclaredMethod("present");
+        present.insertBefore(
+                "{ " +
+                        "  if (this.swapchain == 0L || this.surface == 0L || this.currentImageIndex < 0 || this.currentImageIndex >= this.presentSemaphores.length) {" +
