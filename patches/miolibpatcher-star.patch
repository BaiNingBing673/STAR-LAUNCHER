@@ -0,0 +1,36 @@
+package com.mio.libpatcher.transformer;
+
+import javassist.CtClass;
+import javassist.CtMethod;
+
+/**
+ * Aligns LWJGL's OpenGL FunctionProvider ({@code org.lwjgl.opengl.GL$1}) with SDL3's patched
+ * lookup order on Android: resolve directly from the loaded GL wrapper/driver library via
+ * {@code dlsym} ({@code library.getFunctionAddress}) before consulting {@code glXGetProcAddress} /
+ * {@code eglGetProcAddress}. This prevents global symbol preemption (e.g. RTLD_GLOBAL MobileGlues
+ * or system libGLESv2) from diverging from {@code SDL_GL_GetProcAddress("glGetError")}.
+ */
+public class GLTransformer implements BaseTransformer {
+    @Override
+    public String getTargetClassName() {
+        return "org.lwjgl.opengl.GL$1";
+    }
+
+    @Override
+    public void transform(CtClass clazz) throws Throwable {
+        CtClass byteBufferClass = clazz.getClassPool().get("java.nio.ByteBuffer");
+        CtMethod method = clazz.getDeclaredMethod("getFunctionAddress", new CtClass[]{byteBufferClass});
+        method.setBody(
+                "{"
+                        + "  long addr = this.library.getFunctionAddress($1);"
+                        + "  if (addr == 0L && this.GetProcAddress != 0L) {"
+                        + "    addr = org.lwjgl.system.JNI.callPP(org.lwjgl.system.MemoryUtil.memAddress($1), this.GetProcAddress);"
+                        + "  }"
+                        + "  if (addr == 0L && org.lwjgl.system.Checks.DEBUG_FUNCTIONS) {"
+                        + "    org.lwjgl.system.APIUtil.apiLogMissing(\"GL\", $1);"
+                        + "  }"
+                        + "  return addr;"
+                        + "}"
+        );
+    }
+}
