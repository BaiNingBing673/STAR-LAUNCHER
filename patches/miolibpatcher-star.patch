+                            "{ " +
+                                    "  if ($2 == " + VK_ERROR_SURFACE_LOST_KHR + ") {" +
+                                    "    this.mioSurfaceLost = true;" +
+                                    "    this.swapchainSuboptimal = true;" +
+                                    "    this.swapchainOutOfDate = true;" +
