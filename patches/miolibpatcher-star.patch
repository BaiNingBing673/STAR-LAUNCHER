+    }
+
+    private static void patchAcquireNextTexture(CtClass clazz) throws NotFoundException, CannotCompileException {
+        CtMethod acquire = clazz.getDeclaredMethod("acquireNextTexture");
+        acquire.insertBefore(
+                "{ " +
