+        clazz.addField(CtField.make("private boolean mioSurfaceLost;", clazz));
+        clazz.addField(CtField.make("private String mioLastSurfaceGen;", clazz));
+        clazz.addField(CtField.make("private boolean mioIdentitySupported;", clazz));
+        clazz.addField(CtField.make("private boolean mioTransformMismatch;", clazz));
+
+        CtConstructor ctor = clazz.getDeclaredConstructor(new CtClass[]{
+                clazz.getClassPool().get("com.mojang.renderpearl.backend.vulkan.VulkanDevice"),
+                CtClass.longType
+        });
+        ctor.insertAfter("{ this.mioWindowHandle = $2; this.mioSurfaceLost = false; this.mioLastSurfaceGen = org.lwjgl.sdl.SDLHints.SDL_GetHint(\"SDL_AETHER_SURFACE_GEN\"); }");
+
+        clazz.addMethod(CtNewMethod.make(
+                "private void mioRecreateSurfaceIfNeeded() throws com.mojang.renderpearl.api.device.SurfaceException {" +
+                        "  String curGen = org.lwjgl.sdl.SDLHints.SDL_GetHint(\"SDL_AETHER_SURFACE_GEN\");" +
+                        "  boolean genChanged = curGen != null && !curGen.equals(this.mioLastSurfaceGen);" +
+                        "  if (!this.mioSurfaceLost && !genChanged && this.surface != 0L) { return; }" +
+                        "  this.destroySwapchain();" +
+                        "  if (this.surface != 0L) {" +
+                        "    org.lwjgl.vulkan.KHRSurface.vkDestroySurfaceKHR(this.device.instance().vkInstance(), this.surface, (org.lwjgl.vulkan.VkAllocationCallbacks) null);" +
+                        "    this.surface = 0L;" +
+                        "  }" +
+                        "  if (this.mioWindowHandle == 0L) {" +
+                        "    throw new com.mojang.renderpearl.api.device.SurfaceException(\"Missing SDL window handle for Vulkan surface recreation\");" +
+                        "  }" +
+                        "  if (!org.lwjgl.sdl.SDLHints.SDL_GetHintBoolean(\"SDL_AETHER_SURFACE_READY\", true)) {" +
+                        "    throw new com.mojang.renderpearl.api.device.SurfaceException(\"Android surface is not ready for Vulkan recreation\");" +
+                        "  }" +
+                        "  if ((org.lwjgl.sdl.SDLVideo.SDL_GetWindowFlags(this.mioWindowHandle) & 72L) != 0L) {" +
+                        "    throw new com.mojang.renderpearl.api.device.SurfaceException(\"Vulkan window is hidden or minimized\");" +
+                        "  }" +
+                        "  org.lwjgl.system.MemoryStack stack = org.lwjgl.system.MemoryStack.stackPush();" +
+                        "  try {" +
+                        "    java.nio.LongBuffer pSurface = stack.longs(0L);" +
+                        "    org.lwjgl.vulkan.VkInstance instance = this.device.vkDevice().getPhysicalDevice().getInstance();" +
+                        "    boolean ok = org.lwjgl.sdl.SDLVulkan.SDL_Vulkan_CreateSurface(this.mioWindowHandle, instance, (org.lwjgl.vulkan.VkAllocationCallbacks) null, pSurface);" +
+                        "    if (!ok || pSurface.get(0) == 0L) {" +
+                        "      String err = org.lwjgl.sdl.SDLError.SDL_GetError();" +
+                        "      throw new com.mojang.renderpearl.api.device.SurfaceException(\"Failed to recreate Vulkan surface: \" + (err != null ? err : \"<no error>\"));" +
+                        "    }" +
+                        "    this.surface = pSurface.get(0);" +
+                        "    this.mioLastSurfaceGen = curGen;" +
+                        "    this.mioSurfaceLost = false;" +
+                        "  } finally {" +
+                        "    stack.close();" +
+                        "  }" +
+                        "}",
+                clazz
+        ));
